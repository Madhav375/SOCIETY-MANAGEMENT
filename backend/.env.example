# ---- Server ----
PORT=3000
NODE_ENV=development
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_secret
# Browser origin(s) allowed to call this API (comma-separated). Production: your Vercel URL, no trailing slash.
FRONTEND_URL=http://localhost:5173

# ---- Databases ----
# MongoDB (Atlas in production): complaints, service requests, images, activity logs
MONGODB_URI=mongodb://127.0.0.1:27017/smart_society
# PostgreSQL (hosted in production): users, roles, sessions
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_society
# Set true for hosted Postgres that requires TLS (Render, Neon, Supabase...)
PGSSL=false

# ---- Uploads ----
MAX_UPLOAD_MB=2

# ---- Seed script (npm run seed) ----
# In development the seed falls back to the demo passwords (admin1234 / demo1234).
# In production set these, or the seed generates random passwords and prints them once.
SEED_ADMIN_PASSWORD=
SEED_RESIDENT_PASSWORD=

# ---- Optional ----
# Allow POST /api/admin/reset-demo in production (adds missing sample records). Default: disabled.
ALLOW_DEMO_RESET=false
